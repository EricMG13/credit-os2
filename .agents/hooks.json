{
  "credit-os2-lint-edited": {
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/lint_edited.py",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
