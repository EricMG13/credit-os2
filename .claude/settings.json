{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./**/.env)"]
  },
  "hooks": {
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/dev_claude_activity.py\" hook", "timeout": 5}]}
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/dev_claude_activity.py\" hook", "timeout": 5}]}
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {"type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-edited.sh", "timeout": 180}
        ]
      }
    ]
  }
}
